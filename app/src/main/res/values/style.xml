<?xml version="1.0" encoding="utf-8"?>
<resources>

        <!-- Custom TextAppearance for body -->
        <style name="CustomTypography.Body" parent="TextAppearance.Material3.BodyLarge">
<!--            <item name="android:fontFamily">@font/poppins</item>-->
            <item name="android:textColor">?android:textColorPrimary</item>
        </style>

        <!-- Optional elevated card style -->
        <style name="ElevatedCardStyle" parent="Widget.Material3.CardView.Elevated">
            <item name="cardElevation">8dp</item>
            <item name="cardCornerRadius">16dp</item>
            <item name="android:layout_margin">8dp</item>

        </style>
    <style name="ToolbarTitleFont" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="fontFamily">@font/tangerine_regular</item>
        <item name="android:textSize">40sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>